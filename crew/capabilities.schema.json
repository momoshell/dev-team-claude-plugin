{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/crew/capabilities.schema.json",
  "title": "checkout-pinned crew capability register",
  "description": "Closed, runtime-owned grants. The coding-agent inventory is distinct from role and overlay agent grants.",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "roles",
    "coding_agents"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "coding_agents": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*$": {
          "$ref": "#/$defs/codingagent"
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "required": [
        "lead",
        "planner",
        "builder",
        "reviewer",
        "tech-lead"
      ],
      "additionalProperties": false,
      "properties": {
        "lead": {
          "$ref": "#/$defs/grant"
        },
        "planner": {
          "$ref": "#/$defs/grant"
        },
        "builder": {
          "$ref": "#/$defs/grant"
        },
        "reviewer": {
          "$ref": "#/$defs/grant"
        },
        "tech-lead": {
          "$ref": "#/$defs/grant"
        }
      }
    }
  },
  "$defs": {
    "codingagent": {
      "type": "object",
      "required": [
        "providers",
        "transports",
        "adapter",
        "refuses",
        "display_name",
        "binary",
        "install_hint",
        "availability",
        "availability_reason"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "availability": { "const": "executable" },
            "availability_reason": { "const": "executable" }
          }
        },
        {
          "properties": {
            "availability": { "const": "proposal-stub" },
            "availability_reason": { "enum": ["proposal-stub", "adapter-import-failed"] }
          }
        },
        {
          "properties": {
            "availability": { "const": "discovered-unavailable" },
            "availability_reason": {
              "enum": ["discovered-unavailable", "shim-not-binary", "version-spawn-failed", "version-interrupted"]
            }
          }
        },
        {
          "properties": {
            "availability": { "const": "installed-unconfigured" },
            "availability_reason": { "enum": ["installed-unconfigured", "transport-refused"] }
          }
        }
      ],
      "properties": {
        "default_transport": { "enum": ["acp"] }, "display_name": {
          "type": "string",
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "binary": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "install_hint": {
          "type": "string",
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "availability": { "enum": ["executable", "discovered-unavailable", "installed-unconfigured", "proposal-stub"] },
        "availability_reason": {
          "enum": [
            "executable",
            "proposal-stub",
            "adapter-import-failed",
            "discovered-unavailable",
            "shim-not-binary",
            "version-spawn-failed",
            "version-interrupted",
            "installed-unconfigured",
            "transport-refused"
          ]
        },
        "config": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "acp"
            ]
          }
        },
        "adapter": {
          "$ref": "#/$defs/relpath"
        },
        "refuses": {
          "type": "array",
          "items": {
            "enum": [
              "extensions",
              "skills",
              "mcp_servers",
              "local_provider"
            ]
          }
        }
      }
    },
    "relpath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    },
    "grant": {
      "type": "object",
      "required": [
        "agents",
        "mcp_servers"
      ],
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentgrant"
          }
        },
        "mcp_servers": {
          "type": "array",
          "items": { "$ref": "#/$defs/mcpserver" }
        },
        "by_agent": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*$": {
              "$ref": "#/$defs/agentoverlay"
            }
          }
        }
      }
    },
    "agentoverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": { "$ref": "#/$defs/agentgrant" }
        },
        "mcp_servers": {
          "type": "array",
          "items": { "$ref": "#/$defs/mcpserver" }
        }
      }
    },
    "mcpserver": {
      "type": "object",
      "required": [
        "name",
        "command",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "command": {
          "type": ["object", "null"],
          "properties": {
            "bin": {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["bin", "args"],
          "additionalProperties": false
        },
        "url": {
          "type": ["string", "null"],
          "pattern": "^https?://"
        }
      }
    },
    "agentgrant": {
      "type": "object",
      "required": [
        "name",
        "def"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "def": {
          "$ref": "#/$defs/relpath"
        }
      }
    }
  }
}
