{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/crew/roster.schema.json",
  "title": "crew roster",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "tiers",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tiers": {
      "type": "object",
      "required": [
        "mechanical",
        "build",
        "judge"
      ],
      "additionalProperties": false,
      "properties": {
        "mechanical": {
          "$ref": "#/$defs/tier"
        },
        "build": {
          "$ref": "#/$defs/tier"
        },
        "judge": {
          "$ref": "#/$defs/tier"
        }
      }
    },
    "models": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+/[A-Za-z0-9._-]+$": {
          "$ref": "#/$defs/model"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "required": [
        "lead",
        "planner",
        "builder",
        "reviewer"
      ],
      "additionalProperties": false,
      "properties": {
        "lead": {
          "$ref": "#/$defs/seat"
        },
        "planner": {
          "$ref": "#/$defs/seat"
        },
        "builder": {
          "$ref": "#/$defs/seat"
        },
        "reviewer": {
          "$ref": "#/$defs/seat"
        },
        "tech-lead": {
          "$ref": "#/$defs/seat"
        }
      }
    },
    "seat": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "provider",
        "id",
        "agent",
        "effort"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "agent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/fallbackChain"
        },
        "transport_policy": {
          "$ref": "#/$defs/transportPolicy"
        }
      }
    },
    "transport": {
      "type": "string",
      "enum": ["pane", "headless-json", "headless-rpc", "acp", "headless-api"]
    },
    "offCriticalStage": {
      "type": "string",
      "enum": []
    },
    "transportPolicy": {
      "type": "object",
      "required": ["transports", "batch_eligible"],
      "additionalProperties": false,
      "properties": {
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/transport"
          }
        },
        "batch_eligible": {
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/offCriticalStage"
        }
      },
      "if": {
        "required": ["batch_eligible"],
        "properties": {
          "batch_eligible": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["stage"]
      },
      "else": {
        "not": {
          "required": ["stage"]
        }
      }
    },
    "fallbackChain": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fallbackEntry" }
    },
    "fallbackEntry": {
      "type": "object",
      "additionalProperties": false,
      "title": "a fallback cell",
      "required": ["provider", "id", "agent"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "agent": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "effort": { "$ref": "#/$defs/fallbackEffort" }
      }
    },
    "fallbackEffort": {
      "enum": ["low", "medium", "high", "xhigh", "max"]
    },
    "assurances": {
      "type": "object",
      "required": [
        "quick",
        "standard",
        "rigorous"
      ],
      "additionalProperties": false,
      "properties": {
        "quick": {
          "$ref": "#/$defs/tier"
        },
        "standard": {
          "$ref": "#/$defs/tier"
        },
        "rigorous": {
          "$ref": "#/$defs/tier"
        }
      }
    },
    "rosterV2": {
      "title": "crew roster, schema version 2",
      "type": "object",
      "required": [
        "schema_version",
        "updated_at",
        "assurances",
        "models",
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "updated_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "assurances": {
          "$ref": "#/$defs/assurances"
        },
        "models": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9-]+/[A-Za-z0-9._-]+$": {
              "$ref": "#/$defs/model"
            }
          },
          "additionalProperties": false
        },
        "policy": {
          "type": "object"
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "cost_in_per_mtok",
        "cost_out_per_mtok",
        "context",
        "tags",
        "source",
        "last_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "cost_in_per_mtok": {
          "type": "number",
          "minimum": 0
        },
        "cost_out_per_mtok": {
          "type": "number",
          "minimum": 0
        },
        "cost_cache_read_per_mtok": {
          "type": "number",
          "minimum": 0
        },
        "cost_cache_write_per_mtok": {
          "type": "number",
          "minimum": 0
        },
        "cache_rate_source": {
          "type": "string"
        },
        "context": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}