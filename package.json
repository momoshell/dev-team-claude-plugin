{
  "name": "dev-team-plugin",
  "private": true,
  "type": "module",
  "description": "Dev-only metadata for the dev-team Claude Code plugin (tests/CI). Not part of the plugin runtime.",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 \"**/*.test.mjs\"",
    "ledger:sessions": "node scripts/factory/ledger.mjs sessions",
    "ledger:phases": "node scripts/factory/ledger.mjs phases",
    "ledger:tail": "node scripts/factory/ledger.mjs tail",
    "ledger:procs": "node scripts/factory/ledger.mjs procs",
    "ledger:gate-review-gap": "node scripts/factory/ledger.mjs gate-review-gap",
    "ledger:eligible-tasks": "node scripts/factory/ledger.mjs eligible-tasks",
    "ledger:run-set": "node scripts/factory/ledger.mjs run-set",
    "ledger:task": "node scripts/factory/ledger.mjs task",
    "viz:serve": "node --env-file-if-exists=.env.local visualizer/server/server.mjs",
    "viz:build": "vite build --config visualizer/web/vite.config.mjs",
    "viz:dev": "vite --config visualizer/web/vite.config.mjs",
    "crew:watch": "node scripts/factory/crew-watch.mjs",
    "crew:reap": "node scripts/factory/reap-stale.mjs",
    "crew:review": "node scripts/factory/pr-review.mjs",
    "agent:doctor": "node scripts/factory/agent-doctor.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@dagrejs/dagre": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@xyflow/svelte": "^1.6.6",
    "codemirror": "^6.0.2",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  }
}
