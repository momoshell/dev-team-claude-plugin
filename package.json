{
  "name": "dev-team-plugin",
  "private": true,
  "type": "module",
  "description": "Dev-only metadata for the dev-team Claude Code plugin (tests/CI). Not part of the plugin runtime.",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 \"**/*.test.mjs\"",
    "viz:serve": "node --env-file-if-exists=.env.local visualizer/server/server.mjs",
    "viz:build": "vite build --config visualizer/web/vite.config.mjs",
    "viz:dev": "vite --config visualizer/web/vite.config.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  }
}
